{
  "name": "dune",
  "productName": "Dune",
  "version": "1.0.0",
  "description": "Minimalist Electron chat prototype inspired by Codex",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "node build/install-guard.cjs package-manager",
    "check:install-hygiene": "node build/install-guard.cjs install-hygiene",
    "predev": "pnpm run check:install-hygiene",
    "dev": "electron-forge start",
    "prestart": "pnpm run check:install-hygiene",
    "start": "electron-forge start",
    "postinstall": "node build/prepare-agentlite-runtime.cjs",
    "prepackage": "pnpm run check:install-hygiene",
    "package": "electron-forge package",
    "prepackage:mac": "pnpm run check:install-hygiene",
    "package:mac": "electron-forge package --platform darwin",
    "premake": "pnpm run check:install-hygiene",
    "make": "electron-forge make",
    "premake:mac": "pnpm run check:install-hygiene",
    "make:mac": "electron-forge make --platform darwin",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "pnpm run package",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": {
    "name": "dorianzheng",
    "email": "xingzhengde72@gmail.com"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@onecli-sh/sdk": "^0.2.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.1",
    "autoprefixer": "^10.4.21",
    "better-sqlite3": "^12.8.0",
    "electron": "41.0.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^29.0.1",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@boxlite-ai/agentlite": "github:boxlite-ai/agentlite",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "global-agent": "^3.0.0",
    "lucide-react": "^0.511.0",
    "nanoid": "^5.1.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "pnpm": {
    "overrides": {
      "better-sqlite3": "^12.8.0"
    }
  }
}
